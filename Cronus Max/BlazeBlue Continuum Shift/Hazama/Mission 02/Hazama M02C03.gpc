// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("BBCS Hazama Astral", 1, 0, "sTuNtAsTiC b0Ss")

// Created by sTuNtAsTiC b0Ss

//Instructions
/*
	Activate with LS from the starting position. Stop with RS if need be.
	Script walks forward 1s, then performs Hungry Darkness of 1000 Souls (Astral, 1632143D).
	NOTE: Astral Heat - has activation conditions (Overdrive/100 Heat, opponent low HP, etc).
	Challenge mode usually forces these. If nothing happens, that's the condition, not the script.
*/

int i;
int x=1;

// BlazBlue attack buttons (BBCS defaults, confirmed)
define A = XB360_X;    // weak
define B = XB360_Y;    // medium
define C = XB360_B;    // strong
define D = XB360_A;    // drive

// directions (down renamed d -> dn to avoid clashing with D)
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

define LY = XB360_LY;
define LX = XB360_LX;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	if(i==0)
	{
		combo_stop(move1);
	}
}

combo move1
{
	//Walk forward from starting position
	set(r);
	wait(1000);
	wait(50);
	//Hungry Darkness of 1000 Souls (Astral - 1632143D)
	set(dn);
	set(l);              // 1 (down-back)
	wait(60);
	set(r);              // 6 (forward)
	wait(60);
	set(dn);
	set(r);              // 3 (down-forward)
	wait(60);
	set(dn);             // 2 (down)
	wait(60);
	set(dn);
	set(l);              // 1 (down-back)
	wait(60);
	set(l);              // 4 (back)
	wait(60);
	set(dn);
	set(r);              // 3 (down-forward)
	set(D);
	wait(50);
	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
