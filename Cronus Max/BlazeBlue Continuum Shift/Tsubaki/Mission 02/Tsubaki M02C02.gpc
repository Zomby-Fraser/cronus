//#include <titanone.gph>
//#pragma METAINFO("BBCS Tsubaki M2 C2", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{
	// walk in
	set(r);
	wait(1000);

	// first 236
	set(dn);
	wait(60);
	set(dn);
	set(r);
	wait(60);
	set(r);
	wait(60);

	// second 236 + D  (D Confutatis Maledictis)
	set(dn);
	wait(60);
	set(dn);
	set(r);
	wait(60);
	set(r);
	set(D);
	wait(60);

	// super freeze + travel -> connect before reset
	wait(300);

	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
