// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("BBCS Tsubaki M3 C3", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{
	// walk in
	set(r);
	wait(1000);

	// 22D (charged)
	set(dn);
	wait(60);
	wait(60);
	set(dn);
	wait(60);
	set(D);
	wait(800);
	wait(800);

	// 6C
	set(r);
	set(C);
	wait(60);
	wait(300);

	// C (6C>C)
	set(r);
	set(C);
	wait(60);
	wait(600);
	
	// j.63
	set(dn);
	wait(40);
	wait(40);
	set(u);
	set(r);
	wait(100);

	// j.5C
	set(C);
	wait(60);
	wait(200);

	// j.3
	set(u);
	set(r);
	wait(180);

	// j.5C
	set(C);
	wait(60);
	wait(180);
	
	// j.5C (After C)
	set(C);
	wait(400);

	// 236A
	set(dn);
	wait(60);
	set(dn);
	set(r);
	wait(60);
	set(r);
	set(A);
	wait(250);
	
	// 214C
	set(dn);
	wait(60);
	set(dn);
	set(l);
	wait(60);
	set(l);
	set(C);
	wait(150);

	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
