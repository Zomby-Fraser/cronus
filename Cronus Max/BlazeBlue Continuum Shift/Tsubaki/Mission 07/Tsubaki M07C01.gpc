// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("BBCS Tsubaki M7 C1", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

// Activate as Bang is landing on the ground.

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{	
	// Dash in and jump
	set(r);
	wait(30);	
	wait(30);
	set(r);
	wait(30);
	wait(30);
	set(u);
	set(r);
	wait(250);
	
	// j.8
	set(u);
	wait(60);
	wait(100);
	
	// BC
	set(B);
	set(C);
	wait(60);
	wait(375);
	
	// j.214D
	set(dn);
	wait(60);
	set(l);
	set(dn);
	wait(60);
	set(l);
	set(D);
	wait(60);
	wait(800);
	
	// 236D
	set(dn);
	wait(60);
	set(r);
	set(dn);
	wait(60);
	set(r);
	set(D);
	wait(60);
	wait(1100);
	
	// 5B
	set(B);
	wait(60);
	wait(50);
	
	// 2C
	set(dn);
	set(C);
	wait(60);
	wait(250);
	
	// Dash cancel
	set(r);
	wait(60);
	wait(60);
	set(r);
	wait(60);
	
	// 5C
	set(C);
	wait(60);
	wait(350);
	
	// j.28
	set(dn);
	wait(60);
	wait(60);
	set(dn);
	wait(60);
	set(u);
	wait(60);
	wait(200);
	
	// 5C
	set(C);
	wait(60);
	wait(200);
	
	// j.8
	set(u);
	wait(60);
	wait(100);
	
	// 5C
	set(C);
	wait(60);
	wait(250);
	
	// 5C
	set(C);
	wait(60);
	wait(200);
	
	// 236A
	set(dn);
	wait(60);
	set(dn);
	set(r);
	wait(60);
	set(r);
	set(A);
	wait(60);
	wait(200);
	
	// 214C
	set(dn);
	wait(60);
	set(dn);
	set(l);
	wait(60);
	set(l);
	set(C);
	wait(60);
	
	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
