// Created by XxFrAsZeRxX

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{
	// walk in
	set(r);
	wait(1000);

	// 22 (down, neutral, down)
	set(dn);
	wait(60);
	wait(60);
	set(dn);
	wait(60);

	// A (press, brief hold, release to fire)
	set(A);
	wait(120);
	wait(300);

	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
