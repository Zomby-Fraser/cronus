//#include <titanone.gph>
//#pragma METAINFO("BBCS Tsubaki M1 C5", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{
	set(XB360_BACK);
	
	wait(2000);
	
	// walk in
	set(r);
	wait(1000);

	// neutral jump
	set(u);
	wait(60);      // register jump input
	wait(100);     // release up + clear prejump (4F) & 1st airborne frame -> air-move floor

	// air 236 + A  (A Aequum Eleison)
	set(dn);
	wait(60);
	set(dn);
	set(r);
	wait(60);
	set(r);
	set(A);
	wait(60);

	// let the projectile come out & connect before reset
	wait(200);

	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
