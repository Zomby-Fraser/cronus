//#include <titanone.gph>
//#pragma METAINFO("BBCS Hakumen M2 C4", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{
	// walk in
	set(r);
	wait(1000);

	// [2] charge down (~700ms = ~42F, generous margin)
	set(dn);
	wait(350);
	set(dn);
	wait(350);

	// 8 + D  (up + D to fire Akumetsu)
	set(u);
	set(D);
	wait(60);
	set(u);
	set(D);
	wait(60);

	// super freeze + cinematic -> let it fully trigger
	wait(400);

	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
