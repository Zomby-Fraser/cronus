// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
#include <titanone.gph>
#pragma METAINFO("BBCS Hakumen M7 C1", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{
	set(XB360_BACK);
	
	wait(1700);
	
	// walk in
	set(r);
	wait(600);
	wait(1300);

	// jump for j.D
	set(u);
	wait(60);

	// j.D
	set(D);
	wait(60);
	wait(1300);

	// C
	set(C);
	wait(60);
	wait(200);

	// 214B (Renka)
	set(dn);
	wait(60);
	set(dn);
	set(r);
	wait(60);
	set(r);
	set(B);
	wait(60);
	wait(200);

	// 623A (Kishuu)
	set(l);
	wait(60);
	set(dn);
	wait(60);
	set(dn);
	set(l);
	wait(60);
	set(l);
	set(A);
	wait(60);
	wait(100);

	// A (Enma)
	set(A);
	wait(60);
	wait(100);

	// j.1
	set(u);
	set(l);
	wait(60);
	wait(500);

	// j.2C
	set(dn);
	set(C);
	wait(60);
	set(dn);
	wait(550); //Launches enemy further than in the demo for some reason

	// 2C
	set(dn);
	set(C);
	wait(60);
	set(dn);
	wait(225);i=0; // Fails here I don't know why.

	// (2) 1
	set(u);
	set(l);
	wait(60);
	//wait(175);

	// j.2A
	set(dn);
	set(A);
	wait(60);
	wait(600);i = 0;

	// 4 4 back air dash
	set(l);
	wait(15);
	wait(15);
	set(l);
	wait(60);
	wait(60);

	// j.2A
	set(dn);
	set(A);
	wait(60);
	wait(600);

	// j.C
	set(C);
	wait(60);
	wait(200);

	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
