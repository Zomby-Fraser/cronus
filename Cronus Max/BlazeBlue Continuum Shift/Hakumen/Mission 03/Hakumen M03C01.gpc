// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("BBCS Hakumen M3 C1", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{
	// 66 dash (double-tap forward; release between taps so game reads two presses)
	set(r);
	wait(60);
	wait(60);
	set(r);
	wait(60);       // dash sustains, closing distance

	// air 214 + C  (Tsubaki - grounds on hit)
	set(dn);
	wait(60);
	set(dn);
	set(l);
	wait(60);
	set(l);
	set(C);
	wait(60);
	wait(610);

	// 2B  (down + B, low; cancels to special)
	set(dn);
	set(B);
	wait(60);
	wait(200);       // 2B connects, releases dn -> special-cancel into Gurren

	// 214 + A  (Gurren - wall bounce on air hit)
	set(dn);
	wait(60);
	set(dn);
	set(l);
	wait(60);
	set(l);
	set(A);
	wait(60);
	wait(900);      // wall-bounce travel before 6C (from M2C1 calibration)
	

	// 6C  (forward + C; cancels to supers only)
	set(r);
	set(C);
	wait(100);
	wait(240);       // 6C connects, then super-cancel into Shippu

	// 632146 + C  (Shippu super)
	set(r);          // 6
	wait(60);
	set(dn);
	set(r);          // 3
	wait(60);
	set(dn);         // 2
	wait(60);
	set(dn);
	set(l);          // 1
	wait(60);
	set(l);          // 4
	wait(60);
	set(r);          // 6
	set(C);          // fire
	wait(60);
	wait(400);       // super freeze + cinematic

	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
