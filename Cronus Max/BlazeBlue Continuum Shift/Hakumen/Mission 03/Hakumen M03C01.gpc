//#include <titanone.gph>
//#pragma METAINFO("BBCS Hakumen M3 C1", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{
	// walk in
	set(r);
	wait(1000);
	wait(100);

	// B + C  (simultaneous press, starter)
	set(B);
	set(C);
	wait(60);
	wait(750);       // let the starter connect before the special

	// 214 + A  (Gurren)
	set(dn);
	wait(60);
	set(dn);
	set(l);
	wait(60);
	set(l);
	set(A);
	wait(60);
	wait(1100);       // Gurren connects / wall-bounce before 6C

	// 6C  (forward + C)
	set(r);
	set(C);
	wait(60);
	wait(200);

	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
