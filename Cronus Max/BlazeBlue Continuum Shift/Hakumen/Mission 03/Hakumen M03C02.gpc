// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("BBCS Hakumen M3 C2", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{
	// walk in
	set(r);
	wait(1000);

	// jump (neutral up) to get airborne
	set(u);
	wait(60);
	wait(100);       // clear prejump + 1st airborne frame

	// air B + C  (simultaneous, starter)
	set(B);
	set(C);
	wait(60);
	wait(180);       // let air starter connect

	// air 2C  (down + C in the air)
	set(dn);
	set(C);
	wait(60);
	set(dn);
	wait(60);

	// land -> wait out landing recovery before grounded C
	wait(300);       // descent + landing; must be neutral (no dir) so next C is 5C

	// 5C  (grounded, neutral C -- NOT j.C)
	set(C);
	wait(60);
	wait(250);       // 5C fully connects/recovers -> link into 3C

	// 3C  (down-forward + C, low)
	set(dn);
	set(r);
	set(C);
	wait(60);
	wait(200);

	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
