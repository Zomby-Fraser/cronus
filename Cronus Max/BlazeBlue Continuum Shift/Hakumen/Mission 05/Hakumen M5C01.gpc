// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("BBCS Hakumen M5 C1", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{
	// walk in
	set(r);
	wait(1000);

	// 3C
	set(dn);
	set(r);
	set(C);
	wait(60);
	wait(750);

	// 2B
	set(dn);
	set(B);
	wait(60);
	wait(200);

	// 214A
	set(dn);
	wait(60);
	set(dn);
	set(l);
	wait(60);
	set(l);
	set(A);
	wait(60);
	wait(800);

	// 66 dash
	set(r);
	wait(15);
	wait(15);
	set(r);
	wait(60);
	wait(180);

	// 5A
	set(A);
	wait(60);

	// j.3
	set(dn);
	set(r);
	wait(30);
	set(u);
	set(r);
	wait(60);
	wait(250);

	// j.A
	set(A);
	wait(60);
	wait(300);

	// j.B
	set(B);
	wait(60);
	wait(150);

	// dj.3
	set(u);
	set(r);
	wait(60);
	wait(180);

	// j.2A
	set(dn);
	set(A);
	wait(60);
	wait(600);

	// j.C
	set(C);
	wait(60);
	wait(200);

	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
