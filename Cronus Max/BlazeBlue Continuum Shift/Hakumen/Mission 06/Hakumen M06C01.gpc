// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
#include <titanone.gph>
#pragma METAINFO("BBCS Hakumen M6 C6", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{
	// walk in
	set(r);
	wait(1000);

	// 214B (Renka)
	set(dn);
	wait(60);
	set(dn);
	set(l);
	wait(60);
	set(l);
	set(B);
	wait(60);
	wait(1150);

	// 2C
	set(dn);
	set(C);
	wait(60);
	set(dn);
	wait(300);

	// (2) 3
	set(dn);
	set(r);
	wait(30);
	set(u);
	set(r);
	wait(60);
	wait(100);

	// j.2A
	set(dn);
	set(A);
	wait(60);
	wait(650);

	// j.2C
	set(dn);
	set(C);
	wait(60);
	set(dn);
	wait(500);

	// 2C
	set(dn);
	set(C);
	wait(60);
	set(dn);
	wait(300);

	// j.3
	set(u);
	set(r);
	wait(60);
	wait(80);

	// j.2A
	set(dn);
	set(A);
	wait(60);
	wait(600);

	// j.66 air dash
	set(r);
	wait(15);
	wait(15);
	set(r);
	wait(60);
	wait(60);

	// j.2A
	set(dn);
	set(60);
	set(A);
	wait(60);
	wait(600);

	// j.C
	set(C);
	wait(60);
	wait(600);

	// C
	set(C);
	wait(60);
	wait(775);

	// 3C
	set(dn);
	set(r);
	set(C);
	wait(60);
	wait(200);
	i = 0;

	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
