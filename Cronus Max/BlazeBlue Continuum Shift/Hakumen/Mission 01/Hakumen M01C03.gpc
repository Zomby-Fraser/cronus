// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("BBCS Hakumen M1 C3", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

int i;

define A = XB360_X;
define B = XB360_Y;
define C = XB360_B;
define D = XB360_A;
define u  = XB360_UP;
define dn = XB360_DOWN;
define l  = XB360_LEFT;
define r  = XB360_RIGHT;

main
{
	if(get_val(XB360_LS)) { i = 1; }
	if(get_val(XB360_RS)) { i = 0; }
	if(i==1) { combo_run(move1); }
	if(i==0) { combo_stop(move1); }
}

combo move1
{
	// walk in
	set(r);
	wait(1000);

	// 41236 + C  (Zantetsu)
	set(l);          // 4 back
	wait(60);
	set(dn);
	set(l);          // 1 down-back
	wait(60);
	set(dn);         // 2 down
	wait(60);
	set(dn);
	set(r);          // 3 down-forward
	wait(60);
	set(r);          // 6 forward
	set(C);          // + C
	wait(60);
	wait(150);       // let 1st hit land; move is 2-part (3(14)3)

	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
