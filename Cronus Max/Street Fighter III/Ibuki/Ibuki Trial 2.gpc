// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
#include <titanone.gph>
#pragma METAINFO("SF3 Ibuki Trial 2", 1, 0, "sTuNtAsTiC b0sS")

// Created by sTuNtAsTiC b0sS

//Instructions
/*
	Press start, reset, then click LS. RS to stop. 
*/

int i;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	if(i==0)
	{
		combo_stop(move1);
	}
}

combo move1
{
	set_val(PS4_RIGHT, 100);
    wait(800);
    set_val(PS4_RIGHT, 0);
    wait(180);
    set_val(PS4_SQUARE, 100);
    wait(160);
    set_val(PS4_TRIANGLE, 100);
    set_val(PS4_SQUARE, 0);
    wait(60);
    set_val(PS4_TRIANGLE, 0);
    wait(110);
    set_val(PS4_R1, 100);
    wait(110);
    set_val(PS4_R1, 0);
    wait(60);
    set_val(PS4_DOWN, 100);
    wait(60);
    set_val(PS4_DOWN, 100);
    set_val(PS4_LEFT, 100);
    wait(40);
    set_val(PS4_DOWN, 0);
    set_val(PS4_LEFT, 100);
    wait(20);
    set_val(PS4_UP, 100);
    set_val(PS4_LEFT, 100);
    wait(20);
    set_val(PS4_R2, 100);
    set_val(PS4_UP, 100);
    set_val(PS4_LEFT, 100);
    wait(10);
    set_val(PS4_R2, 100);
    set_val(PS4_UP, 100);
    set_val(PS4_LEFT, 0);
    wait(10);
    set_val(PS4_R2, 100);
    set_val(PS4_UP, 0);
    wait(30);
    set_val(PS4_R2, 0);
	i = 0;
}

