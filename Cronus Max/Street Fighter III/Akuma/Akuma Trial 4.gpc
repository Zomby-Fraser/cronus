// Created by sTuNtAsTiC b0Ss

//Instructions
/*
	Walk up to the other player (do not push them into the corner) and activate with LS. Stop with RS if need be.
*/

int i;

define lk = XB360_A;
define mk = XB360_B;
define hk = XB360_RT;

define lp = XB360_X;
define mp = XB360_Y;
define hp = XB360_RB;

define LY = XB360_LY;
define LX = XB360_LX;

define d = XB360_DOWN;
define r = XB360_RIGHT;
define l = XB360_LEFT;
define u = XB360_UP;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	if(i==0)
	{
		combo_stop(move1);
	}
}

combo move1
{
	set(hk);
	wait(20);
	set(lp);
	wait(25);
	rel(lp);
	wait(25);
	set(lp);
	wait(50);
	rel(lp);
	wait(50);
	set(r);
	wait(50);
	set(lk);
	wait(50);
	set(hp);
	wait(50);
	i = 0;
}

function set(button)
{
	set_val(button, 100);
}

function rel(button)
{
	set_val(button, 0);
}