// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
#include <titanone.gph>
#pragma METAINFO("SF3 Alex Trial 4", 1, 0, "sTuNtAsTiC b0sS")

// Created by sTuNtAsTiC b0sS

//Instructions
/*
	Walk up to the other player and push them into the corner and take a couple steps back and activate with LS. Stop with RS if need be.
*/

int i;
int x=1;

define lk = XB360_A;
define mk = XB360_B;
define hk = XB360_RT;

define lp = XB360_X;
define mp = XB360_Y;
define hp = XB360_RB;

define LY = XB360_LY;
define LX = XB360_LX;

define d = XB360_DOWN;
define r = XB360_RIGHT;
define l = XB360_LEFT;
define u = XB360_UP;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	
	if(i == 0)
	{
		combo_stop(move1);
	}
}

combo move1
{
    set_val(PS4_DOWN, 100);
    wait(100);
    set_val(PS4_R1, 100);
    set_val(PS4_DOWN, 100);
    wait(70);
    set_val(PS4_R1, 0);
    set_val(PS4_DOWN, 100);
    wait(110);
    set_val(PS4_DOWN, 0);
    wait(700);
    set_val(PS4_TRIANGLE, 100);
    wait(60);
    set_val(PS4_TRIANGLE, 0);
    wait(30);
    set_val(PS4_RIGHT, 100);
    wait(30);
    set_val(PS4_DOWN, 100);
    set_val(PS4_RIGHT, 100);
    wait(20);
    set_val(PS4_DOWN, 100);
    set_val(PS4_RIGHT, 0);
    wait(70);
    set_val(PS4_DOWN, 100);
    set_val(PS4_RIGHT, 100);
    wait(20);
    set_val(PS4_DOWN, 0);
    set_val(PS4_RIGHT, 100);
    set_val(PS4_CIRCLE, 100);
    set_val(PS4_CROSS, 100);
    wait(30);
    set_val(PS4_RIGHT, 0);
    set_val(PS4_CIRCLE, 100);
    set_val(PS4_CROSS, 100);
    wait(10);
    set_val(PS4_CIRCLE, 0);
    set_val(PS4_CROSS, 0);
	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
