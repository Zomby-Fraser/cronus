// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
#include <titanone.gph>
#pragma METAINFO("SF3 Alex Trial 1", 1, 0, "sTuNtAsTiC b0sS")

// Created by sTuNtAsTiC b0sS

//Instructions
/*
	Walk up to the other player (do not push them into the corner) and activate with LS. Stop with RS if need be.
*/

int i;
int x=1;

define lk = XB360_A;
define mk = XB360_B;
define hk = XB360_RT;

define lp = XB360_X;
define mp = XB360_Y;
define hp = XB360_RB;

define LY = XB360_LY;
define LX = XB360_LX;

define d = XB360_DOWN;
define r = XB360_RIGHT;
define l = XB360_LEFT;
define u = XB360_UP;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	if(i==2)
	{
		combo_run(move2);
	}
}

combo move1
{
	set(mp);
	wait(50);
	i = i + 1;
}

combo move2
{
	set(d);
	wait(25);
	set(d);
	set(r);
	wait(25);
	set(r);
	wait(25);
	set(hp);
	set(mp);
	wait(500);
	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
