// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
#include <titanone.gph>
#pragma METAINFO("SF3 Remy Trial 2", 1, 0, "sTuNtAsTiC b0sS")

// Created by sTuNtAsTiC b0sS

//Instructions
/*
	Walk up to the other player and push them into the corner take a step or two back so the tips of their shoes are touching, then activate with LS. It may take a few tries. Stop with RS if need be.
*/

int i;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	
	if(i == 0)
	{
		combo_stop(move1);
	}
}

