// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
#include <titanone.gph>
#pragma METAINFO("SF3 Alex Trial 4", 1, 0, "sTuNtAsTiC b0sS")

// Created by sTuNtAsTiC b0sS

//Instructions
/*
	Walk up to the other player and push them into the corner back up 1 or 2 steps, then activate with LS. It may take a few tries. Stop with RS if need be.
*/

int i;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	
	if(i == 0)
	{
		combo_stop(move1);
	}
}

combo move1
{
    set_val(PS4_DOWN, 100);
    wait(2510);
    set_val(PS4_DOWN, 100);
    set_val(PS4_TRIANGLE, 100);
    wait(60);
    set_val(PS4_DOWN, 100);
    set_val(PS4_TRIANGLE, 0);
    wait(80);
    set_val(PS4_DOWN, 0);
    wait(20);
    set_val(PS4_UP, 100);
    wait(40);
    set_val(PS4_R2, 100);
    set_val(PS4_UP, 100);
    wait(110);
    set_val(PS4_R2, 0);
    set_val(PS4_UP, 100);
    wait(10);
	i = 0;
}
