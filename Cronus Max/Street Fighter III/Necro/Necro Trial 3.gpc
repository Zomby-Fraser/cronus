// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
#include <titanone.gph>
#pragma METAINFO("SF3 Necro Trial 3", 1, 0, "sTuNtAsTiC b0sS")

// Created by sTuNtAsTiC b0sS

//Instructions
/*
	Walk up to the other player and push them into the corner, take a step back, and activate with LS. Stop with RS if need be.
*/

int i;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	
	if(i == 0)
	{
		combo_stop(move1);
	}
}

combo move1
{
	set_val(PS4_LEFT, 100);
    wait(60);
    set_val(PS4_DOWN, 100);
    set_val(PS4_LEFT, 100);
    wait(90);
