// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
#include <titanone.gph>
#pragma METAINFO("SF3 Makoto Trial 1", 1, 0, "sTuNtAsTiC b0sS")

// Created by sTuNtAsTiC b0sS

//Instructions
/*
	Press start, reset, then click LS. RS to stop. 
*/

int i;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	if(i==0)
	{
		combo_stop(move1);
	}
}

combo move1
{
	set_val(PS4_RIGHT, 100);
    wait(1210);
    set_val(PS4_RIGHT, 0);
    wait(910);
    set_val(PS4_CROSS, 100);
    wait(40);
    set_val(PS4_CROSS, 0);
    wait(20);
    set_val(PS4_DOWN, 100);
    wait(60);
    set_val(PS4_DOWN, 100);
    set_val(PS4_RIGHT, 100);
    wait(40);
    set_val(PS4_DOWN, 0);
    set_val(PS4_RIGHT, 100);
    set_val(PS4_SQUARE, 100);
    wait(40);
    set_val(PS4_RIGHT, 100);
    set_val(PS4_SQUARE, 0);
    wait(10);
    set_val(PS4_RIGHT, 0);
	i = 0;
}

