#include <titanone.gph>
#pragma METAINFO("SF3 Chun-Li Trial 4", 1, 0, "sTuNtAsTiC b0sS")

// Created by sTuNtAsTiC b0sS

//Instructions
/*
	Walk up to the other player. Stop with RS if need be.
*/

int i;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	
	if(i == 0)
	{
		combo_stop(move1);
	}
}

combo move1
{
