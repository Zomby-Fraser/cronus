//Instructions
/*
	Walk up to the other player move them all the way right. Activate with LS. This works about 50% of the time. Just keep trying. Stop with RS if need be.
*/

int i;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	
	if(i == 0)
	{
		combo_stop(move1);
	}
}

