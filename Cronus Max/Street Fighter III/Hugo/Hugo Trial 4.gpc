// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
#include <titanone.gph>
#pragma METAINFO("SF3 Hugo Trial 4", 1, 0, "sTuNtAsTiC b0sS")

// Created by sTuNtAsTiC b0sS

//Instructions
/*
	Walk up to the other player and push them into the corner and take a couple steps back and activate with LS. Stop with RS if need be.
*/

int i;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	
	if(i == 0)
	{
		combo_stop(move1);
	}
}

combo move1
{
	set_val(PS4_DOWN, 100);
    wait(90);
    set_val(PS4_DOWN, 100);
set_val(PS4_LEFT, 100);
    wait(40);
    set_val(PS4_DOWN, 0);
    set_val(PS4_LEFT, 100);
    wait(50);
    set_val(PS4_LEFT, 100);
    set_val(PS4_CROSS, 100);
    wait(20);
    set_val(PS4_LEFT, 0);
    set_val(PS4_CROSS, 100);
    wait(30);
    set_val(PS4_CROSS, 0);
    wait(740);
    set_val(PS4_RIGHT, 100);
    wait(100);
    set_val(PS4_RIGHT, 0);
    wait(70);
    set_val(PS4_RIGHT, 100);
    wait(180);
    set_val(PS4_RIGHT, 0);
    wait(250);
    set_val(PS4_RIGHT, 100);
    wait(20);
    set_val(PS4_DOWN, 100);
    set_val(PS4_RIGHT, 100);
    wait(20);
    set_val(PS4_DOWN, 100);
    set_val(PS4_RIGHT, 0);
    wait(50);
    set_val(PS4_DOWN, 100);
    set_val(PS4_LEFT, 100);
    wait(40);
    set_val(PS4_DOWN, 0);
    set_val(PS4_LEFT, 100);
    wait(60);
    set_val(PS4_LEFT, 0);
    set_val(PS4_CROSS, 100);
    wait(60);
    set_val(PS4_CROSS, 0);
    wait(650);
    set_val(PS4_DOWN, 100);
    wait(60);
    set_val(PS4_DOWN, 100);
    set_val(PS4_LEFT, 100);
    wait(40);
    set_val(PS4_DOWN, 0);
    set_val(PS4_LEFT, 100);
    wait(50);
    set_val(PS4_LEFT, 100);
    set_val(PS4_SQUARE, 100);
    wait(20);
    set_val(PS4_LEFT, 0);
    set_val(PS4_SQUARE, 100);
    wait(50);
    set_val(PS4_SQUARE, 0);
    wait(220);
    set_val(PS4_DOWN, 100);
    wait(100);
    set_val(PS4_DOWN, 100);
    set_val(PS4_RIGHT, 100);
    wait(10);
    set_val(PS4_DOWN, 0);
    set_val(PS4_RIGHT, 100);
    wait(40);
    set_val(PS4_UP, 100);
    set_val(PS4_RIGHT, 100);
    wait(60);
    set_val(PS4_UP, 0);
    set_val(PS4_RIGHT, 100);
    wait(30);
    set_val(PS4_DOWN, 100);
    set_val(PS4_RIGHT, 100);
    wait(10);
    set_val(PS4_DOWN, 100);
    set_val(PS4_RIGHT, 0);
    wait(80);
    set_val(PS4_DOWN, 100);
    set_val(PS4_RIGHT, 100);
    wait(20);
    set_val(PS4_DOWN, 0);
    set_val(PS4_RIGHT, 100);
    wait(120);
    set_val(PS4_RIGHT, 0);
    set_val(PS4_CROSS, 100);
    wait(50);
    set_val(PS4_CROSS, 0);
	i = 0;
}