// Created by sTuNtAsTiC b0Ss

//Instructions
/*
	Walk up to the other player, push them into the corner, and activate with LS. Stop with RS if need be.
*/

int i;
int x=1;

define lk = XB360_A;
define mk = XB360_B;
define hk = XB360_RT;

define lp = XB360_X;
define mp = XB360_Y;
define hp = XB360_RB;

define LY = XB360_LY;
define LX = XB360_LX;

define d = XB360_DOWN;
define r = XB360_RIGHT;
define l = XB360_LEFT;
define u = XB360_UP;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	if(i==0)
	{
		combo_stop(move1);
	}
}

combo move1
{
	//Jumping Roundhouse
	set(u);
	set(r);
	wait(400);
	set(hk);
	wait(600);
	//Crouching Strong
	set(d);
	set(mp);
	wait(50);
	//EX Spin Scythe
	set(d);
	set(l);
	wait(50);
	set(l);
	set(lk);
	set(mk);
	wait(1400);
	//EX Rhino Horn
	set(l);
	wait(25);
	set(l);
	set(d);
	wait(25);
	set(d);
	wait(25);
	set(d);
	set(r);
	wait(25);
	set(r);
	set(lk);
	set(mk);
	wait(950);
	//EX Scratch Wheel
	set(r);
	wait(50);
	set(d);
	wait(50);
	set(d);
	set(r);
	set(lk);
	set(mk);
	wait(50);
	i = 0;
}

function set(button)
{
	set_val(button, 100);
}

function rel(button)
{
	set_val(button, 0);
}