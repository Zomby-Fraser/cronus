#include <titanone.gph>
#pragma METAINFO("SF3 Yang Trial 1", 1, 0, "sTuNtAsTiC b0sS")

// Created by sTuNtAsTiC b0sS

//Instructions
/*
	Pause and reset then activate with LS. It may take a few tries. Stop with RS if need be.
*/

int i;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	
	if(i == 0)
	{
		combo_stop(move1);
	}
}

combo move1
{
    set_val(PS4_CROSS, 100);
    wait(40);
    set_val(PS4_CROSS, 0);
    wait(1880);
    set_val(PS4_RIGHT, 100);
    wait(600);
    set_val(PS4_RIGHT, 0);
    wait(740);
