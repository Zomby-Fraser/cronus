// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
#include <titanone.gph>
#pragma METAINFO("SF3 Yun Trial 1", 1, 0, "XxFrAsZeRxX")

// Created by XxFrAsZeRxX

//Instructions
/*
	Pause and reset then activate with LS. It may take a few tries. Stop with RS if need be.
*/

int i;
int x=1;

define lk = XB360_A;
define mk = XB360_B;
define hk = XB360_RT;

define lp = XB360_X;
define mp = XB360_Y;
define hp = XB360_RB;

define LY = XB360_LY;
define LX = XB360_LX;

define d = XB360_DOWN;
define r = XB360_RIGHT;
define l = XB360_LEFT;
define u = XB360_UP;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	
	if(i == 0)
	{
		combo_stop(move1);
	}
}

combo move1
{
    set_val(PS4_RIGHT, 100);
    wait(610);
    set_val(PS4_RIGHT, 0);
    wait(1000);
    set_val(PS4_DOWN, 100);
    wait(2080);
    set_val(PS4_DOWN, 100);
    set_val(PS4_CIRCLE, 100);
    wait(60);
    set_val(PS4_DOWN, 100);
    set_val(PS4_CIRCLE, 0);
    wait(30);
    set_val(PS4_DOWN, 100);
    set_val(PS4_RIGHT, 100);
    wait(40);
    set_val(PS4_DOWN, 0);
    set_val(PS4_RIGHT, 100);
    wait(50);
    set_val(PS4_RIGHT, 100);
    set_val(PS4_SQUARE, 100);
    wait(20);
    set_val(PS4_RIGHT, 0);
    set_val(PS4_SQUARE, 100);
    wait(30);
    set_val(PS4_SQUARE, 0);
	i = 0;
}

function set(button)
{
	set_val(button, 100);
}
