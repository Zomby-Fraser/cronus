// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 Dhalsim Hard Trial 2", 1, 0, "XxFrAsZeRxX")

//Stand as far away as possible and then activate. Does not work if activated all the way at the right side of the arena.
int i;

define lk = XB360_A;
define mk = XB360_B;
define hk = XB360_RT;

define lp = XB360_X;
define mp = XB360_Y;
define hp = XB360_RB;

define LY = XB360_LY;
define LX = XB360_LX;

define d = XB360_DOWN;
define r = XB360_RIGHT;
define l = XB360_LEFT;
define u = XB360_UP;

define p = XB360_LB;
define k = XB360_LT;

main { // block start
                                                       
    if(event_press(XB360_BACK   ))combo_run(move1);
                                                       
    if(event_press(XB360_RS))combo_stop(move1);
                                                       
}// main block end

combo move1 {
   wait(500);
   set_val(XB360_DOWN,100);
   wait(20);
   set_val(XB360_DOWN,100);
   set_val(XB360_RIGHT,100);
   wait(20);
   set_val(XB360_RIGHT,100);
   wait(20);
   set_val(XB360_X,100);
   wait(20);
   wait(800);
   //Teleport
   set(u);
   wait(250);
   set(r);
   wait(20);
   set(d);
   wait(20);
   set(d);
   set(r);
   wait(20);
   set(p);
   wait(400);
   wait(500);
   set_val(XB360_RB,100);
   wait(20);
   wait(400);
   set_val(XB360_DOWN,100);
   wait(20);
   set_val(XB360_DOWN,100);
   set_val(XB360_RIGHT,100);
   wait(20);
   set_val(XB360_RIGHT,100);
   wait(20);
   set_val(XB360_DOWN,100);
   wait(20);
   set_val(XB360_DOWN,100);
   set_val(XB360_RIGHT,100);
   wait(20);
   set_val(XB360_RIGHT,100);
   wait(20);
   set_val(XB360_X,100);
   wait(20);
}

combo dashf
{
	set(r);
	wait(25);
	rel(r);
	wait(25);
	set(r);
	wait(25);
	rel(r);
	wait(25);
}

function set(button)
{
	set_val(button, 100);
}

function rel(button)
{
	set_val(button, 0);
}
