#include <titanone.gph>
#pragma METAINFO("Akihiko Trial 4", 1, 0, "sTuNtAsTiC b0sS")

// Change the mapping: click the back button on the bottom 5 to clear these so no button is assigned

// Start the trial and activate with LS. Stop with RS.

// Performed and recorded by sTuNtAsTiC b0sS, organized by XxFrAsZeRxX

int i; //declares variable
main
{
	if(get_val(XB360_LS))//When LS is pressed, i=1
	{
		i=1;
	}
	if(get_val(XB360_RS)) //When Xbox button is pressed, i=0;
	{
		i=0;
	}
	if(i==1) //For *OPTION 1*
	{	
		combo_run(Host);
	}
	if(i==0) //Stops all macros
	{
		combo_stop(Host);
	}
}

combo Host //Macro for Host
{
	set_val(PS4_LY, -100);
	wait(170);
	set_val(PS4_LY, 0);
	wait(240);
	set_val(PS4_LX, 100);
	wait(20);
	set_val(PS4_LX, 100);
	set_val(PS4_LY, 100);
	wait(10);
	set_val(PS4_LX, 0);
	set_val(PS4_LY, 100);
	wait(60);
	set_val(PS4_LX, -100);
	set_val(PS4_LY, 100);
	wait(20);
	set_val(PS4_LX, -100);
	set_val(PS4_LY, 0);
	wait(30);
	set_val(PS4_LX, -100);
	set_val(PS4_SQUARE, 100);
	wait(20);
	set_val(PS4_LX, 0);
	set_val(PS4_SQUARE, 100);
	wait(140);
	set_val(PS4_SQUARE, 0);
	i=0;
}
